#!/usr/bin/env python3
"""Build a TUI feature clip from a JSON spec.

Two panes named `before` and `after` make a comparison clip; a single pane makes
a solo clip, for a feature that has nothing to compare against. A spec with a
`render.explode` section instead takes its one capture apart, piece by piece.
A spec with a `render.donut` section films nothing at all: its picture is the
numbers it carries, drawn as a ring and read one section at a time.

    tui-clip specs/thing.json                 # capture, render, encode
    tui-clip specs/thing.json --skip-capture  # reuse out/<name>/*.png
    tui-clip specs/thing.json --stills        # capture only, then stop
    tui-clip specs/thing.json --draft         # half size, fast encode

Captures land in out/<name>/, the frame sequence in out/<name>/frames/, and the
finished mp4 in out/<name>.mp4.
"""
from __future__ import annotations

import argparse
import json
import math
import os
import shutil
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "lib"))
import render  # noqa: E402
import capture as capture_lib  # noqa: E402


def expand(value: str, ctx: dict) -> str:
    for k, v in ctx.items():
        value = value.replace("{" + k + "}", v)
    return os.path.expandvars(os.path.expanduser(value))


def shot_path(shot: str, pane: str, shots_dir: str, ctx: dict) -> str:
    """where a `{"shot": ...}` step writes.

    A bare word is a *name*: the shot is one of the screens this clip is drawn
    on, and `render.annotations[i].shot` picks it by that name. Anything that
    looks like a path stays one, which is how a run drops a capture next to a
    dump of the same screen.
    """
    if "/" in shot or "{" in shot:
        return expand(shot, ctx)
    return os.path.join(shots_dir, f"{pane}-{shot}.png")


def run_dir(name: str, pane: str, shots_dir: str) -> str:
    """where a `{"record": ...}` step writes its frame sequence"""
    return os.path.join(shots_dir, f"{pane}-{name}")


def run_frames(name: str, pane: str, shots_dir: str) -> list[str]:
    d = run_dir(name, pane, shots_dir)
    if not os.path.isdir(d):
        return []
    return [os.path.join(d, f) for f in sorted(os.listdir(d)) if f.endswith(".png")]


def xdg_env(scratch: str, pane: str) -> dict:
    """per-pane XDG directories, so a clip cannot touch a real install.

    A program that keeps history, sessions or a plugin cache will find them,
    write to them, and show a different screen the second time it is filmed.
    Pointed at a scratch of their own, each pane starts from the same nothing
    every time.
    """
    base = os.path.join(scratch, "xdg", pane)
    env = {}
    for var, sub in (("XDG_DATA_HOME", "data"), ("XDG_STATE_HOME", "state"),
                     ("XDG_CACHE_HOME", "cache"), ("XDG_CONFIG_HOME", "config"),
                     ("XDG_RUNTIME_DIR", "run")):
        d = os.path.join(base, sub)
        os.makedirs(d, mode=0o700, exist_ok=True)
        env[var] = d
    return env


def capture(spec: dict, pane: str, out_png: str, proj: str, scratch: str,
            shots_dir: str, report_path: str | None = None) -> None:
    cap = spec["capture"]
    p = cap["panes"][pane]
    ctx = {"scratch": scratch, "proj": proj, "pane": pane}
    # `workdir` opts out of the scratch copy, for a program that has to be
    # pointed at a real tree to have anything to show.
    workdir = expand(p.get("workdir", cap.get("workdir", "{proj}")), ctx)
    argv = [os.path.join(ROOT, "bin", "tui-capture"),
            "--out", out_png,
            "--geometry", cap["geometry"],
            "--font", cap["font"],
            "--workdir", workdir,
            "--display", cap.get("display", ":99"),
            "--screen", cap.get("screen", "1600x2200x24"),
            "--settle", str(p.get("settle", cap.get("settle", 8))),
            "--term", cap.get("term", "xfce4-terminal"),
            "--backend", cap.get("backend", "xwd"),
            "--grab-fps", str(cap.get("grab_fps", 30)),
            "--type-settle", str(cap.get("type_settle", 0.4)),
            "--locale", cap.get("locale", "C.UTF-8"),
            "--keep-display"]
    if cap.get("key_settle") is not None:
        argv += ["--key-settle", str(cap["key_settle"])]
    if cap.get("verify"):
        argv += ["--verify", json.dumps(cap["verify"])]
    if report_path:
        argv += ["--report", report_path]
    env = {}
    if cap.get("xdg", True):
        env.update(xdg_env(scratch, pane))
    for k, v in {**cap.get("env", {}), **p.get("env", {})}.items():
        env[k] = expand(v, ctx)
    for k, v in env.items():
        argv += ["--env", f"{k}={v}"]
    for step in [*cap.get("keys", []), *p.get("keys", [])]:
        argv += step_argv(step, pane, shots_dir, ctx)
    argv += ["--"] + [expand(a, ctx) for a in p["argv"]]
    print(f"  capturing {pane} ...", flush=True)
    subprocess.run(argv, check=True, stdout=subprocess.DEVNULL)


def step_argv(step: dict, pane: str, shots_dir: str, ctx: dict) -> list[str]:
    """one spec step as flags for tui-capture"""
    if "key" in step:
        # {"key": "Down", "repeat": 12} -> one travel, not twelve jumps
        d = {"key": step["key"]}
        if int(step.get("repeat", 1)) > 1:
            d["repeat"] = int(step["repeat"])
        if "settle" in step:
            d["settle"] = float(step["settle"])
        return ["--key", json.dumps(d) if len(d) > 1 else step["key"]]
    if "type" in step:
        d = {"text": step["type"]}
        if "settle" in step:
            d["settle"] = float(step["settle"])
        return ["--type", json.dumps(d) if len(d) > 1 else step["type"]]
    if "sleep" in step:
        return ["--sleep", str(step["sleep"])]
    if "at" in step:
        # Absolute: be here `at` seconds past the last {"mark": true},
        # whatever the steps in between cost. See tui-capture.
        return ["--at", str(step["at"])]
    if step.get("mark"):
        return ["--mark"]
    if "shot" in step:
        return ["--shot", shot_path(step["shot"], pane, shots_dir, ctx)]
    if "record" in step:
        # A run is opened, not blocked on: the steps after it are the point,
        # since they are what puts the keystroke and the animation it causes
        # inside the same recording.
        d = {"name": step["record"],
             "dir": run_dir(step["record"], pane, shots_dir),
             "seconds": step.get("seconds", 5),
             "fps": step.get("fps", 30)}
        if step.get("keep"):
            d["keep"] = int(step["keep"])
            d["anchor"] = step.get("anchor", "max-diff")
        return ["--record", json.dumps(d)]
    for kind in ("drag", "click", "move"):
        if kind in step:
            return [f"--{kind}", json.dumps(step[kind])]
    if step.get("park"):
        return ["--park"]
    raise SystemExit(f"unknown capture step {step!r}")


def take(spec: dict, outdir: str, skip_capture: bool
         ) -> tuple[list[str], dict, dict, dict]:
    """film one spec's panes into `outdir`, or find what an earlier take left.

    Returns the panes, the final capture of each, and the named shots and runs
    the key sequence took. Everything after this reads files, which is what
    lets `--skip-capture` re-render from a take without re-filming it.
    """
    shots_dir = os.path.join(outdir, "shots")
    os.makedirs(outdir, exist_ok=True)
    # A donut clip draws its own picture, so there is nothing to film and no
    # terminal to film it in; every stage below that needs a capture is keyed
    # off this being empty rather than off the mode, since "no panes" is the
    # whole of what a captureless clip means to the pipeline.
    panes = list(spec.get("capture", {}).get("panes", {}))
    captures = {p: os.path.join(outdir, f"{p}.png") for p in panes}

    if panes and not skip_capture:
        # Work on a copy in scratch: many TUIs keep per-directory session state,
        # and we must not disturb whatever the user has open for real.
        scratch = os.path.join(outdir, "scratch")
        proj = os.path.join(scratch, "proj")
        shutil.rmtree(scratch, ignore_errors=True)
        os.makedirs(proj, exist_ok=True)
        shutil.rmtree(shots_dir, ignore_errors=True)
        os.makedirs(shots_dir, exist_ok=True)
        for entry in spec["capture"].get("copy_files", []):
            # a string copies under its own name; {"src", "as"} renames, for a
            # doc whose real filename would read wrong in the file explorer
            as_ = entry.get("as") if isinstance(entry, dict) else None
            src = expand(entry["src"] if isinstance(entry, dict) else entry, {})
            shutil.copy(src, os.path.join(proj, as_ or os.path.basename(src)))
        # A program that reads a config directory shows a different UI with and
        # without one, so a clip that wants the real look has to bring a copy —
        # a copy, so the run cannot write back over the real thing.
        for src, dst in spec["capture"].get("copy_dirs", {}).items():
            dst = expand(dst, {"scratch": scratch, "proj": proj})
            shutil.copytree(expand(src, {}), dst, dirs_exist_ok=True,
                            ignore=shutil.ignore_patterns(".git", "logs"))
        reports = {}
        try:
            for pane in panes:
                rp = os.path.join(outdir, f"take-{pane}.json")
                capture(spec, pane, captures[pane], proj, scratch, shots_dir, rp)
                if os.path.exists(rp):
                    with open(rp) as fh:
                        reports[pane] = json.load(fh)
        finally:
            # one Xvfb for every pane; tear it down however we got here
            subprocess.run([os.path.join(ROOT, "bin", "tui-capture"), "--stop",
                            "--display", spec["capture"].get("display", ":99")],
                           check=False)
        bad = False
        for pane, rep in reports.items():
            print(f"  take {pane}:")
            print("    " + capture_lib.report_text(rep).replace("\n", "\n    "))
            bad = bad or any(r.get("verify", {}).get("ok") is False
                             for r in rep.get("runs", {}).values())
        if bad:
            # Worth knowing before four minutes of rendering, not after.
            print("  ! a run failed its verify; see the report above",
                  file=sys.stderr)

    shots, runs = {}, {}
    for pane in panes:
        for step in [*spec["capture"].get("keys", []),
                     *spec["capture"]["panes"][pane].get("keys", [])]:
            if not isinstance(step, dict):
                continue
            n = step.get("shot")
            if n and "/" not in n and "{" not in n:
                shots[n] = shot_path(n, pane, shots_dir, {})
            r = step.get("record")
            if r:
                runs[r] = run_frames(r, pane, shots_dir)

    for f in [*captures.values(), *shots.values()]:
        if not os.path.exists(f):
            raise SystemExit(f"missing capture {f} (drop --skip-capture?)")
    for rname, seq in runs.items():
        if not seq:
            raise SystemExit(
                f"recording {rname!r} produced no frames in "
                f"{run_dir(rname, panes[0], shots_dir)} (drop --skip-capture?)")
    return panes, captures, shots, runs


def reel(spec: dict, base: str, outdir: str, skip_capture: bool
         ) -> tuple[dict, list[str], dict, dict, dict]:
    """film every scene a reel lists, and hand back one solo spec made of them.

    A reel is a run of short solo clips cut together -- a release, a tour, a
    list of changes -- where each scene needs a program started its own way
    and so cannot be one take. Each scene is an ordinary solo spec, filmed
    into `out/<reel>/<scene>/` exactly as it would be on its own, and
    renderable on its own too. The reel then renames everything a scene
    took into the scene's namespace -- its final screen is shot `<scene>`,
    its shot `card` is `<scene>.card`, its run `open` is `<scene>.open` --
    and concatenates the scenes' beats, so the cut from one scene to the next
    is an ordinary beat-to-beat transition, drawn by the same code as every
    other one. That is also why every scene has to share one geometry: a push
    carries two screens through one camera.
    """
    entries = spec["reel"]
    if not entries:
        raise SystemExit("reel is empty; nothing to show")
    r = spec["render"]
    anns, views = [], dict(r.get("views", {}))
    first = None
    shots, runs = {}, {}
    for entry in entries:
        entry = {"spec": entry} if isinstance(entry, str) else dict(entry)
        path = os.path.join(base, expand(entry["spec"], {}))
        with open(path) as fh:
            scene = json.load(fh)
        # named for its file, not its `name`: a scene spec's name is chosen
        # to be unique among clips, and so tends to carry a version's dots
        key = entry.get("as", os.path.splitext(os.path.basename(path))[0])
        if "." in key:
            raise SystemExit(f"reel scene name {key!r}: no dots, they separate "
                             "a scene from its shots; name it with \"as\"")
        if render.mode_of(scene) != "solo":
            raise SystemExit(f"reel scene {key!r} is not a solo clip; a reel "
                             "cuts single screens together")
        sr = scene.get("render", {})
        for dim in ("rows", "cols"):
            if int(sr.get(dim, r[dim])) != int(r[dim]):
                raise SystemExit(
                    f"reel scene {key!r} has render.{dim}={sr[dim]}, the reel "
                    f"{r[dim]}; every scene must be filmed at one geometry")
        print(f"  scene {key}", flush=True)
        panes, caps, sshots, sruns = take(scene, os.path.join(outdir, key),
                                          skip_capture)
        shots[key] = caps[panes[0]]
        first = first or caps[panes[0]]
        for n, f in sshots.items():
            shots[f"{key}.{n}"] = f
        for n, fs in sruns.items():
            runs[f"{key}.{n}"] = fs
        for n, v in sr.get("views", {}).items():
            views[f"{key}.{n}"] = v

        def ns(name: str) -> str:
            return f"{key}.{name}"
        beats = entry.get("annotations", sr.get("annotations"))
        if not beats:
            raise SystemExit(f"reel scene {key!r} has no annotations")
        for i, a in enumerate(beats):
            a = json.loads(json.dumps(a))
            if isinstance(a.get("shots"), str):
                a["shots"] = ns(a["shots"])
            elif isinstance(a.get("shots"), list):
                a["shots"] = [ns(n) for n in a["shots"]]
            a["shot"] = ns(a["shot"]) if a.get("shot") else key
            if a.get("view"):
                a["view"] = ns(a["view"])
            if a.get("swipe", {}).get("to"):
                a["swipe"]["to"] = ns(a["swipe"]["to"])
            # the cut into a scene is its first beat's transition; the entry
            # names it so a scene spec need not know where in a reel it sits
            if i == 0 and entry.get("transition") and anns:
                a["transition"] = entry["transition"]
            anns.append(a)
    out = {k: v for k, v in spec.items() if k != "reel"}
    out["capture"] = {"panes": {"reel": {}}}
    out["render"] = {**r, "annotations": anns, "views": views}
    return out, ["reel"], {"reel": first}, shots, runs


def draft(spec: dict) -> None:
    """the same clip at a fraction of the size, for checking the framing.

    Every framing decision -- what a note points at, whether a pane is wide
    enough, whether two things collide -- is legible at half size, and half
    size with a fast encode renders in tens of seconds rather than minutes.

    The size is derived rather than left to the caller: libx264 refuses a
    dimension that is not divisible by two, and a chrome draws at 1/scale of
    the canvas and needs that to divide as well. Both of those are things a
    person discovers by hitting them.
    """
    r = spec["render"]
    w, h = r.get("size", [1080, 1080])
    if r.get("chrome"):
        # A chrome lays itself out at 1/scale of the canvas and upscales. Halve
        # the upscale, not the layout: halving the layout would shrink the
        # window's own type relative to its furniture, which is the one thing
        # a chrome draft must not change.
        cs = int(r["chrome"].get("scale", 3))
        ns = max(1, cs - 1)
        f = ns / cs
        r["chrome"] = {**r["chrome"], "scale": ns}
        step = math.lcm(2, ns)
    else:
        f, step = 0.5, 2
    nw = max(step, int(w * f) // step * step)
    nh = max(step, int(h * f) // step * step)
    r["size"] = [nw, nh]
    r["draft_scale"] = nw / w
    r["fps"] = min(int(r.get("fps", 60)), 30)
    spec["encode"] = {"crf": 30, "preset": "ultrafast"}
    print(f"  draft: {w}x{h} -> {nw}x{nh} at {r['fps']}fps", flush=True)


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("spec")
    ap.add_argument("--skip-capture", action="store_true")
    ap.add_argument("--stills", action="store_true")
    ap.add_argument("--draft", action="store_true",
                    help="half size, 30fps, fast encode -- for checking the "
                         "framing before paying for the real render")
    ap.add_argument("--out")
    args = ap.parse_args()

    with open(args.spec) as fh:
        spec = json.load(fh)
    name = spec["name"]
    outdir = os.path.join(ROOT, "out", name)
    frames = os.path.join(outdir, "frames")
    os.makedirs(outdir, exist_ok=True)
    if args.draft:
        draft(spec)

    if "reel" in spec:
        spec, panes, captures, shots, runs = reel(
            spec, os.path.dirname(os.path.abspath(args.spec)), outdir,
            args.skip_capture)
    else:
        render.mode_of(spec)             # validates the pane set
        panes, captures, shots, runs = take(spec, outdir, args.skip_capture)
    mode = render.mode_of(spec)

    if args.stills:
        if not panes:
            print(f"  {name} films nothing; there are no stills to check")
            return
        for f in [*captures.values(), *shots.values()]:
            print(f)
        for rname, seq in runs.items():
            print(f"{rname}: {len(seq)} frames")
        return

    print(f"  rendering frames ({mode}) ...", flush=True)
    r = render.make(spec, captures, frames, shots, runs)
    nf = r.run()
    dur = nf / r.fps
    print(f"  {nf} frames, {dur:.2f}s")

    mp4 = args.out or os.path.join(ROOT, "out", f"{name}.mp4")
    enc = spec.get("encode", {})
    subprocess.run([
        "ffmpeg", "-y", "-v", "error",
        "-framerate", str(r.fps), "-i", os.path.join(frames, "f%05d.png"),
        # a silent track keeps players that expect audio happy (X does)
        "-f", "lavfi", "-t", f"{dur:.3f}", "-i", "anullsrc=r=48000:cl=stereo",
        "-map", "0:v", "-map", "1:a",
        "-c:v", "libx264", "-preset", enc.get("preset", "slow"),
        "-crf", str(enc.get("crf", 18)),
        "-profile:v", "high", "-level", "4.0", "-pix_fmt", "yuv420p",
        "-c:a", "aac", "-b:a", "96k", "-shortest", "-movflags", "+faststart",
        mp4,
    ], check=True)
    print(mp4)


if __name__ == "__main__":
    main()
