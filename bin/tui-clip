#!/usr/bin/env python3
"""Build a before/after TUI comparison clip from a JSON spec.

    tui-clip specs/thing.json                 # capture, render, encode
    tui-clip specs/thing.json --skip-capture  # reuse out/<name>/{before,after}.png
    tui-clip specs/thing.json --stills        # capture only, then stop

Captures land in out/<name>/, the frame sequence in out/<name>/frames/, and the
finished mp4 in out/<name>.mp4.
"""
from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "lib"))
import render  # noqa: E402


def expand(value: str, ctx: dict) -> str:
    for k, v in ctx.items():
        value = value.replace("{" + k + "}", v)
    return os.path.expandvars(os.path.expanduser(value))


def capture(spec: dict, pane: str, out_png: str, proj: str, scratch: str) -> None:
    cap = spec["capture"]
    p = cap["panes"][pane]
    ctx = {"scratch": scratch, "proj": proj, "pane": pane}
    argv = [os.path.join(ROOT, "bin", "tui-capture"),
            "--out", out_png,
            "--geometry", cap["geometry"],
            "--font", cap["font"],
            "--workdir", proj,
            "--display", cap.get("display", ":99"),
            "--screen", cap.get("screen", "1600x2200x24"),
            "--settle", str(p.get("settle", cap.get("settle", 8))),
            "--keep-display"]
    for k, v in {**cap.get("env", {}), **p.get("env", {})}.items():
        argv += ["--env", f"{k}={expand(v, ctx)}"]
    for step in cap.get("keys", []):
        if "key" in step:
            argv += ["--key", step["key"]]
        elif "type" in step:
            argv += ["--type", step["type"]]
        elif "sleep" in step:
            argv += ["--sleep", str(step["sleep"])]
    argv += ["--"] + [expand(a, ctx) for a in p["argv"]]
    print(f"  capturing {pane} ...", flush=True)
    subprocess.run(argv, check=True, stdout=subprocess.DEVNULL)


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("spec")
    ap.add_argument("--skip-capture", action="store_true")
    ap.add_argument("--stills", action="store_true")
    ap.add_argument("--out")
    args = ap.parse_args()

    with open(args.spec) as fh:
        spec = json.load(fh)
    name = spec["name"]
    outdir = os.path.join(ROOT, "out", name)
    frames = os.path.join(outdir, "frames")
    os.makedirs(outdir, exist_ok=True)
    before = os.path.join(outdir, "before.png")
    after = os.path.join(outdir, "after.png")

    if not args.skip_capture:
        # Work on a copy in scratch: many TUIs keep per-directory session state,
        # and we must not disturb whatever the user has open for real.
        scratch = os.path.join(outdir, "scratch")
        proj = os.path.join(scratch, "proj")
        shutil.rmtree(scratch, ignore_errors=True)
        os.makedirs(proj, exist_ok=True)
        for src in spec["capture"].get("copy_files", []):
            src = expand(src, {})
            shutil.copy(src, os.path.join(proj, os.path.basename(src)))
        try:
            capture(spec, "before", before, proj, scratch)
            capture(spec, "after", after, proj, scratch)
        finally:
            # one Xvfb for both panes; tear it down however we got here
            subprocess.run([os.path.join(ROOT, "bin", "tui-capture"), "--stop",
                            "--display", spec["capture"].get("display", ":99")],
                           check=False)

    for f in (before, after):
        if not os.path.exists(f):
            raise SystemExit(f"missing capture {f} (drop --skip-capture?)")
    if args.stills:
        print(before)
        print(after)
        return

    print("  rendering frames ...", flush=True)
    r = render.Renderer(spec, before, after, frames)
    nf = r.run()
    dur = nf / r.fps
    print(f"  {nf} frames, {dur:.2f}s")

    mp4 = args.out or os.path.join(ROOT, "out", f"{name}.mp4")
    enc = spec.get("encode", {})
    subprocess.run([
        "ffmpeg", "-y", "-v", "error",
        "-framerate", str(r.fps), "-i", os.path.join(frames, "f%05d.png"),
        # a silent track keeps players that expect audio happy (X does)
        "-f", "lavfi", "-t", f"{dur:.3f}", "-i", "anullsrc=r=48000:cl=stereo",
        "-map", "0:v", "-map", "1:a",
        "-c:v", "libx264", "-preset", enc.get("preset", "slow"),
        "-crf", str(enc.get("crf", 18)),
        "-profile:v", "high", "-level", "4.0", "-pix_fmt", "yuv420p",
        "-c:a", "aac", "-b:a", "96k", "-shortest", "-movflags", "+faststart",
        mp4,
    ], check=True)
    print(mp4)


if __name__ == "__main__":
    main()
