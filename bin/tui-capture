#!/usr/bin/env bash
# Screenshot a terminal program running on a headless X display.
#
# The program is launched in its own xfce4-terminal on an Xvfb display, driven
# with xdotool, and captured with ImageMagick `import`. Nothing touches the
# user's real session.
#
#   tui-capture --out shot.png --geometry 64x50 --font "JetBrains Mono 21" \
#               --workdir /tmp/proj --settle 8 \
#               --env XDG_DATA_HOME=/tmp/scratch/data \
#               --unset 'CLAUDE_*' \
#               --key ctrl+p --type "toggle compose" --key Return \
#               -- /usr/bin/myeditor README.md
#
# --shot takes a screenshot mid-sequence, in among the keys. That is how a
# capture and something the program can only tell you afterwards — a UI tree
# dump, say — come from one run and so describe the same screen.
#
# --record DIR:SECONDS:FPS films the window instead of photographing it, with
# ffmpeg's x11grab straight off the Xvfb display. `import` costs 200-400ms a
# frame and jitters, which is fine for a screen that is holding still and
# useless for one that is not: anything driven by a wall clock — an animation,
# a transition, a simulation — has to be recorded, not sampled. Frames land in
# DIR as 0001.png upward, and a spec turns the run into a beat's `shots`.
#
# Recording does NOT block: ffmpeg is started and the key sequence carries on
# over it, so the steps that follow are filmed. That is what lets a clip open
# on the screen at rest and then show the thing being triggered — put the
# --record before the keystroke that starts it, and a --sleep in between. The
# run ends on its own after SECONDS; the sequence waits for it at the end.
set -euo pipefail

DISPLAY_NUM=":99"
SCREEN="1600x2200x24"
GEOMETRY="80x24"
FONT="JetBrains Mono 21"
WORKDIR="$PWD"
SETTLE=8
OUT=""
ACTIONS=()
ENVS=()
UNSETS=()
KEEP=0
STOP=0

die() { echo "tui-capture: $*" >&2; exit 1; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --display)  DISPLAY_NUM="$2"; shift 2 ;;
    --screen)   SCREEN="$2";      shift 2 ;;
    --geometry) GEOMETRY="$2";    shift 2 ;;
    --font)     FONT="$2";        shift 2 ;;
    --workdir)  WORKDIR="$2";     shift 2 ;;
    --settle)   SETTLE="$2";      shift 2 ;;
    --out)      OUT="$2";         shift 2 ;;
    --env)      ENVS+=("$2");     shift 2 ;;
    --unset)    UNSETS+=("$2");   shift 2 ;;
    --key)      ACTIONS+=("key:$2");   shift 2 ;;
    --shot)     ACTIONS+=("shot:$2");  shift 2 ;;
    --record)   ACTIONS+=("record:$2"); shift 2 ;;
    --type)     ACTIONS+=("type:$2");  shift 2 ;;
    --sleep)    ACTIONS+=("sleep:$2"); shift 2 ;;
    --keep-display) KEEP=1; shift ;;
    --stop) STOP=1; shift ;;
    --) shift; break ;;
    *) die "unknown flag $1" ;;
  esac
done
if [[ $STOP -eq 1 ]]; then
  # Match, then kill by pid: a `pkill -f` pattern can match the shell running
  # this script and take it out along with the target.
  export DISPLAY="$DISPLAY_NUM"
  for pid in $(pgrep -f "xfce4-terminal --disable-server" 2>/dev/null || true); do
    kill "$pid" 2>/dev/null || true
  done
  sleep 1
  for pid in $(pgrep -x Xvfb 2>/dev/null || true); do
    tr "\0" " " < "/proc/$pid/cmdline" 2>/dev/null \
      | grep -q -- " $DISPLAY_NUM " && kill -9 "$pid" 2>/dev/null || true
  done
  exit 0
fi

[[ -n "$OUT" ]] || die "--out is required"
[[ $# -gt 0 ]] || die "no command given (put it after --)"
CMD=("$@")

for t in Xvfb xfce4-terminal xdotool import ffmpeg; do
  command -v "$t" >/dev/null || die "missing required tool: $t"
done

export DISPLAY="$DISPLAY_NUM"
# --unset takes a glob and drops every exported variable matching it. A capture
# inherits the environment of whatever launched it, and some of that leaks into
# the program being filmed: an agent started from inside another agent's session
# reads the parent's variables and prints a warning about it, which then belongs
# to the clip forever. Clearing them is not cosmetic -- the recording should
# show what a user would see, not what this harness happened to export.
for name in $(compgen -e); do
  for u in "${UNSETS[@]:-}"; do
    [[ -n "$u" ]] || continue
    # shellcheck disable=SC2254  -- the pattern is meant to glob
    case "$name" in $u) unset "$name" ;; esac
  done
done
for e in "${ENVS[@]:-}"; do [[ -n "$e" ]] && export "${e?}"; done

# Start Xvfb only if this display is not already answering.
started_xvfb=0
if ! timeout 2 xdotool getdisplaygeometry >/dev/null 2>&1; then
  setsid nohup Xvfb "$DISPLAY_NUM" -screen 0 "$SCREEN" -nolisten tcp \
    >/tmp/tui-clips-xvfb$$.log 2>&1 < /dev/null &
  started_xvfb=1
  sleep 2
  timeout 3 xdotool getdisplaygeometry >/dev/null 2>&1 \
    || die "Xvfb $DISPLAY_NUM did not come up (see /tmp/tui-clips-xvfb$$.log)"
fi

# NOTE: never `pkill -f xfce4-terminal` here. A -f pattern can match the shell
# that is running this script. Match, then kill by pid.
for pid in $(pgrep -f "xfce4-terminal --disable-server" 2>/dev/null || true); do
  kill "$pid" 2>/dev/null || true
done
sleep 1

setsid nohup xfce4-terminal --disable-server \
  --hide-menubar --hide-toolbar --hide-scrollbar --hide-borders \
  --geometry="$GEOMETRY" --font="$FONT" --working-directory="$WORKDIR" \
  -x "${CMD[@]}" >/tmp/tui-clips-term$$.log 2>&1 < /dev/null &

sleep "$SETTLE"

WID="$(xdotool search --name "Terminal - " | tail -1 || true)"
[[ -n "$WID" ]] || die "no terminal window appeared (see /tmp/tui-clips-term$$.log)"
xdotool windowfocus "$WID"
sleep 0.5

REC_PIDS=(); REC_DIRS=()
for a in "${ACTIONS[@]:-}"; do
  [[ -n "$a" ]] || continue
  case "$a" in
    key:*)   spec="${a#key:}"
             if [[ "$spec" == *"*"* ]]; then
               # NAME*N -- N presses back to back. A scroll driven one press
               # per action would spend a minute on what the program does in
               # a second, and would land as N jumps rather than one travel.
               xdotool key --window "$WID" --repeat "${spec##*\*}" \
                       --repeat-delay 40 "${spec%%\**}"
               sleep 0.4
             else
               xdotool key --window "$WID" "$spec"; sleep 1.2
             fi ;;
    type:*)  xdotool type  --window "$WID" --delay 40 "${a#type:}"; sleep 1.2 ;;
    sleep:*) sleep "${a#sleep:}" ;;
    shot:*)  mkdir -p "$(dirname "${a#shot:}")"
             import -window "$WID" "${a#shot:}" ;;
    record:*)
             IFS=: read -r rdir rsecs rfps <<< "${a#record:}"
             mkdir -p "$rdir"
             # Grab the window's rectangle off the display rather than the
             # window itself: x11grab takes a screen region, and on a headless
             # Xvfb the window is the only thing in it anyway.
             eval "$(xdotool getwindowgeometry --shell "$WID")"
             # x11grab wants even dimensions for most encoders; PNG does not
             # care, but keeping it even avoids a stride surprise if the frames
             # are ever muxed straight to video.
             ffmpeg -v error -y -f x11grab -draw_mouse 0 \
                    -video_size "$((WIDTH - WIDTH % 2))x$((HEIGHT - HEIGHT % 2))" \
                    -framerate "$rfps" -i "${DISPLAY_NUM}+${X},${Y}" \
                    -t "$rsecs" -fps_mode passthrough "$rdir/%04d.png" &
             REC_PIDS+=("$!"); REC_DIRS+=("$rdir") ;;
  esac
done
# Let any recording run out its clock before the window is torn down.
for pid in "${REC_PIDS[@]:-}"; do [[ -n "$pid" ]] && wait "$pid" || true; done
for d in "${REC_DIRS[@]:-}"; do
  [[ -n "$d" ]] && echo "recorded $(ls "$d" | wc -l) frames -> $d" >&2
done
sleep 1.5

mkdir -p "$(dirname "$OUT")"
import -window "$WID" "$OUT"

for pid in $(pgrep -f "xfce4-terminal --disable-server" 2>/dev/null || true); do
  kill "$pid" 2>/dev/null || true
done
if [[ $started_xvfb -eq 1 && $KEEP -eq 0 ]]; then
  for pid in $(pgrep -x Xvfb 2>/dev/null || true); do
    tr "\0" " " < "/proc/$pid/cmdline" 2>/dev/null \
      | grep -q -- " $DISPLAY_NUM " && kill -9 "$pid" 2>/dev/null || true
  done
fi

echo "$OUT"
