#!/usr/bin/env python3
"""Screenshot or film a terminal program running on a headless X display.

The program is launched in its own terminal on an Xvfb display, driven with
xdotool, and grabbed with `xwd`. Nothing touches the user's real session.

    tui-capture --out shot.png --geometry 64x50 --font "JetBrains Mono 21" \\
                --workdir /tmp/proj --settle 8 \\
                --env XDG_DATA_HOME=/tmp/scratch/data \\
                --key ctrl+p --type "toggle compose" --key Return \\
                -- /usr/bin/myeditor README.md

--shot photographs the screen mid-sequence, in among the keys. That is how a
capture and something the program can only tell you afterwards -- a UI tree
dump, say -- come from one run and so describe the same screen.

--record NAME:DIR:SECONDS keeps a stretch of frames instead of one. It does
NOT block: the run opens and the steps after it carry on inside it, which is
the only way a keystroke and the animation it causes land in the same run. Put
the --record before the keystroke, with a --sleep in between.

Grabbing does not start or stop with a run. It runs from the first step to the
last, and a run only decides which frames are kept -- see lib/capture.py for
why that matters, and README for how to check whether it matters on your
stack. `--backend x11grab` opts out of all of it and streams with ffmpeg.

--record takes a JSON object for the rest of its options:

    --record '{"name":"switch","dir":"out/frames","seconds":6,"keep":18}'

`keep` trims the run to that many frames around the largest change in it,
which is how a 180ms animation is found without being told when to expect it.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "lib"))
import capture  # noqa: E402


class Step(argparse.Action):
    """collect the action flags in the order they were given"""

    def __call__(self, parser, ns, value, option_string=None):
        ns.actions = getattr(ns, "actions", None) or []
        ns.actions.append((self.dest, value))


def jarg(value: str, key: str = None) -> dict:
    """a JSON object, or a bare value under `key` for the short spelling"""
    value = value.strip()
    if value.startswith("{"):
        return json.loads(value)
    return {key: value} if key else json.loads(value)


def parse_record(value: str) -> dict:
    if value.strip().startswith("{"):
        d = json.loads(value)
    else:
        # NAME:DIR:SECONDS[:FPS], for driving it by hand
        parts = value.split(":")
        if len(parts) < 3:
            raise SystemExit("--record wants NAME:DIR:SECONDS or a JSON object")
        d = {"name": parts[0], "dir": parts[1], "seconds": float(parts[2])}
        if len(parts) > 3:
            d["fps"] = float(parts[3])
    d.setdefault("name", os.path.basename(d["dir"]))
    return d


def main() -> None:
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--display", default=":99")
    ap.add_argument("--screen", default="1600x2200x24")
    ap.add_argument("--geometry", default="80x24")
    ap.add_argument("--font", default="JetBrains Mono 21")
    ap.add_argument("--workdir")
    ap.add_argument("--settle", type=float, default=8.0)
    ap.add_argument("--out")
    ap.add_argument("--env", action="append", default=[])
    ap.add_argument("--term", default="xfce4-terminal", choices=capture.Session.TERMS)
    ap.add_argument("--backend", default="xwd",
                    choices=["xwd", "import", "x11grab"],
                    help="how frames are taken. xwd is the cheap shutter and "
                         "the default; x11grab streams with ffmpeg instead and "
                         "turns the continuous grab off")
    ap.add_argument("--grab-fps", type=float, default=30.0,
                    help="target continuous grab rate; 0 grabs flat out")
    ap.add_argument("--key-settle", type=float, default=None,
                    help="pause after a key. Defaults to 0.12 where grabbing "
                         "is continuous (the animation being filmed is often "
                         "shorter than the pause), and to 1.2 under x11grab, "
                         "where a shot is the only observation there is")
    ap.add_argument("--type-settle", type=float, default=0.4)
    ap.add_argument("--locale", default="C.UTF-8",
                    help="LANG/LC_ALL for the program. A terminal decoding "
                         "box-drawing glyphs as latin-1 wraps every line")
    ap.add_argument("--drain-dir", help="where discarded grabs go")
    ap.add_argument("--verify", help="JSON: regions to measure per frame")
    ap.add_argument("--report", help="write the take report here as JSON")
    ap.add_argument("--keep-display", action="store_true")
    ap.add_argument("--stop", action="store_true")

    for flag, dest in [("--key", "key"), ("--type", "type"),
                       ("--sleep", "sleep"), ("--shot", "shot"),
                       ("--record", "record"), ("--drag", "drag"),
                       ("--click", "click"), ("--move", "move"),
                       ("--park", "park")]:
        ap.add_argument(flag, dest=dest, action=Step,
                        nargs=0 if dest == "park" else None)

    args, rest = ap.parse_known_args()
    actions = getattr(args, "actions", None) or []
    if rest and rest[0] == "--":
        rest = rest[1:]

    if args.stop:
        # Terminals first: they are children of the display, and one left
        # running holds a grab on a display that is about to go.
        capture.Session(display=args.display, term=args.term).kill_terms()
        time.sleep(0.5)
        capture.kill_display(args.display)
        return
    if not args.out:
        raise SystemExit("tui-capture: --out is required")
    if not rest:
        raise SystemExit("tui-capture: no command given (put it after --)")

    env = {}
    for e in args.env:
        k, _, v = e.partition("=")
        env[k] = v

    s = capture.Session(
        display=args.display, screen=args.screen, geometry=args.geometry,
        font=args.font, workdir=args.workdir, settle=args.settle,
        term=args.term, backend=args.backend, grab_fps=args.grab_fps,
        key_settle=args.key_settle, type_settle=args.type_settle,
        locale=args.locale, env=env)

    drain = args.drain_dir or os.path.join(
        os.path.dirname(os.path.abspath(args.out)), "drain")
    report = {}
    try:
        s.start_x()
        s.launch(rest)
        s.begin_grabbing(drain)
        for kind, value in actions:
            if kind == "key":
                if value.strip().startswith("{"):
                    d = json.loads(value)
                    s.key(d["key"], int(d.get("repeat", 1)), d.get("settle"))
                else:
                    spec, _, rep = value.partition("*")
                    s.key(spec, int(rep or 1))
            elif kind == "type":
                if value.strip().startswith("{"):
                    d = json.loads(value)
                    s.type(d["text"], d.get("settle"))
                else:
                    s.type(value)
            elif kind == "sleep":
                time.sleep(float(value))
            elif kind == "shot":
                s.shot(value)
            elif kind == "record":
                d = parse_record(value)
                s.record(d["name"], d["dir"], d["seconds"],
                         d.get("fps", 30), d.get("keep", 0),
                         d.get("anchor", "max-diff"))
            elif kind == "drag":
                s.drag(**jarg(value))
            elif kind == "click":
                s.click(**jarg(value))
            elif kind == "move":
                s.move(**jarg(value))
            elif kind == "park":
                s.park()
        s.await_runs()
        s.shot(args.out)
        s.end_grabbing()
        report = s.finish(json.loads(args.verify) if args.verify else None)
    finally:
        s.stop(keep_display=args.keep_display)

    if report:
        print(capture.report_text(report), file=sys.stderr)
        if args.report:
            with open(args.report, "w") as fh:
                json.dump(report, fh, indent=1)
    print(args.out)


if __name__ == "__main__":
    main()
